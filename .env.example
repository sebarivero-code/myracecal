# URL pública del sitio (para SEO: canonical, sitemap, Open Graph)
# En producción: https://www.agendabiker.com (sin barra final)
NEXT_PUBLIC_SITE_URL=https://www.agendabiker.com

# Google Sheets URL
# Formato: https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv&gid={GID}
# O simplemente: https://docs.google.com/spreadsheets/d/{SHEET_ID}
GOOGLE_SHEET_URL=

# NextAuth Configuration
# En local: http://localhost:3000
# En producción: https://agendabiker.com (debe coincidir con el dominio público)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu_secret_key_aqui_genera_una_con_openssl_rand_base64_32

# Google OAuth Credentials
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui

# Google Analytics 4 (opcional)
# Crea una propiedad en https://analytics.google.com y pega aquí el ID de medición (ej: G-XXXXXXXXXX)
# Si no lo configurás, la app funciona igual; solo no se envían métricas.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cuenta de servicio para Google Sheets (opcional; permite planilla restringida)
# Si NO las configurás: la planilla debe estar en "Quien tenga el enlace puede ver".
# Si SÍ las configurás: podés restringir la planilla y compartirla solo con el email de la cuenta
# (ej. xxx@yyy.iam.gserviceaccount.com) como "Lector". Ver GOOGLE_SHEETS_SETUP.md.
# GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

